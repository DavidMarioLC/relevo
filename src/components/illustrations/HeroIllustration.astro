    <circle cx="825" cy="544" r="4" /><circle cx="624" cy="451" r="3.6" />
    <circle cx="49" cy="382" r="1.8" /><circle cx="132" cy="430" r="1.8" /><circle cx="298" cy="430" r="1.8" />
