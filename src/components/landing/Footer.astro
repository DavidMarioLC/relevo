---
import { ArrowRight } from '@lucide/astro';
import Brand from './Brand.astro';
import { footerGroups } from '../../data/landing';
---
<footer>
  <div class="footer-grid">
    <div class="footer-tagline">A sealed home<br />for agents that<br />never sleep.</div>
    {footerGroups.slice(0, 3).map(group => <div class="footer-group"><h2>{group.title}</h2><ul>{group.items.map(item => <li>{item.href ? <a href={item.href}>{item.label}</a> : <span aria-disabled="true" title={`${item.label} — coming soon`}>{item.label}<span class="sr-only"> — coming soon</span></span>}</li>)}</ul></div>)}
    <div class="subscribe"><h2>Subscribe</h2><p>New templates and agent setups, only when they’re worth opening.</p><div class="email-field"><label for="email" class="sr-only">Email address</label><input id="email" type="email" placeholder="you@company.com" disabled aria-describedby="subscribe-status" /><button disabled aria-label="Subscribe — coming soon"><ArrowRight class="ui-icon" size={16} stroke-width={1.5} aria-hidden="true" focusable="false" /></button></div><span id="subscribe-status" class="subscribe-status">Subscriptions opening soon.</span></div>
    {footerGroups.slice(3).map(group => <div class="footer-group"><h2>{group.title}</h2><ul>{group.items.map(item => <li>{item.href ? <a href={item.href}>{item.label}</a> : <span aria-disabled="true" title={`${item.label} — coming soon`}>{item.label}<span class="sr-only"> — coming soon</span></span>}</li>)}</ul></div>)}
  </div>
  <div class="footer-bottom"><div class="copyright"><Brand compact /><span>© 2026 RELEVO. All rights reserved.</span></div><div class="legal"><span aria-disabled="true" title="Privacy policy — coming soon">Privacy policy</span><span aria-disabled="true" title="Terms & conditions — coming soon">Terms &amp; conditions</span><span aria-disabled="true" title="Contact — coming soon">Contact</span></div></div>
</footer>
<style>
  footer { border-top: 1px solid var(--line); }
  .footer-grid { display: grid; grid-template-columns: 1.3fr 1fr 1fr 1fr; }
  .footer-grid > div { padding: 22px 18px; min-width: 0; border-bottom: 1px solid var(--line); }
  .footer-grid > div:not(:nth-child(4n + 1)) { border-left: 1px solid var(--line); }
  .footer-tagline { font: 30px/.99 var(--serif); letter-spacing: -.06em; }
  h2 { font: 10px/1.4 var(--mono); color: var(--muted); text-transform: uppercase; letter-spacing: 0; margin-bottom: 12px; }
  ul { list-style: none; padding: 0; }
  li { font-size: 12px; line-height: 1.3; }
  li > a, li > span { display: flex; align-items: center; min-height: 32px; }
  .subscribe p { font-size: 12px; line-height: 1.4; margin: 0 0 13px; max-width: 300px; }
  .email-field { display: flex; border: 1px solid var(--line); }
  input { padding: 10px; border: 0; min-width: 0; width: 100%; background: transparent; font-size: 11px; border-radius: 0; opacity: 1; }
  input::placeholder { color: var(--muted); }
  .email-field button { display: grid; place-items: center; min-width: 44px; height: 44px; border: 0; border-left: 1px solid var(--line); background: transparent; color: var(--muted); }
  .subscribe-status { display: block; margin-top: 7px; font-size: 10px; color: var(--muted); }
  .footer-bottom { display: flex; justify-content: space-between; }
  .copyright { display: flex; align-items: center; gap: 8px; padding: 12px 16px; font-size: 10px; }
  .legal { display: flex; }
  .legal > span { display: flex; align-items: center; padding: 12px 14px; border-left: 1px solid var(--line); font: 9px var(--mono); text-transform: uppercase; }
  @media (hover: hover) and (pointer: fine) { li > a:hover { color: var(--orange-text); } }
  @media (min-width: 768px) and (max-width: 1023px) {
    .footer-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .footer-grid > div:not(:nth-child(4n + 1)) { border-left: 0; }
    .footer-grid > div:nth-child(even) { border-left: 1px solid var(--line); }
  }
  @media (max-width: 1023px) { .footer-tagline { font-size: 25px; } .footer-bottom { flex-wrap: wrap; } .legal > span:first-child { border-left: 0; } }
  @media (max-width: 767px) {
    .footer-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .footer-grid > div { padding: 22px 20px; }
    .footer-grid > div:not(:nth-child(4n + 1)) { border-left: 0; }
    .footer-grid > div:nth-child(even) { border-left: 1px solid var(--line); }
    .footer-tagline { font-size: 28px; }
    .subscribe { grid-column: 1 / -1; border-left: 0 !important; }
    .footer-grid > div:nth-child(6), .footer-grid > div:nth-child(8) { border-left: 0; }
    .footer-grid > div:nth-child(7) { border-left: 1px solid var(--line); }
    li > a, li > span { min-height: 44px; }
    .copyright { flex-wrap: wrap; gap: 8px; min-height: 58px; font-size: 9px; }
    .legal { flex-wrap: wrap; width: 100%; border-top: 1px solid var(--line); }
    .legal > span { flex: 1; justify-content: center; padding: 14px 8px; font-size: 8px; text-align: center; }
  }
  @media (max-width: 374px) { .footer-grid > div { padding: 20px 16px; } .footer-tagline { font-size: 24px; } }
</style>
