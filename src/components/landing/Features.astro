---
import Scene from '../illustrations/Scene.astro';
import { features } from '../../data/landing';
---
<section id="features" class="features section-pad" aria-labelledby="features-title">
  <span class="eyebrow">Features</span>
  <h2 id="features-title" class="section-title">Everything it needs to keep working<br /><span class="soft">while you’re away.</span></h2>
  <div class="features-grid">
    {features.map(feature => <article class="feature">
      <div class="feature-art"><Scene kind={feature.scene} /></div>
      <div class="feature-copy"><h3>{feature.title}</h3><p>{feature.description}</p></div>
    </article>)}
  </div>
</section>
<style>
  .features { border-top: 1px solid var(--line); padding-top: 112px; padding-bottom: 112px; }
  .features-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 42px; border: 1px solid var(--line); }
  .feature { min-width: 0; }
  .feature + .feature { border-left: 1px solid var(--line); }
  .feature-art { padding: 20px 8px 0; }
  .feature-copy { padding: 25px 24px 26px; }
  h3 { font-size: 18px; letter-spacing: -.055em; margin-bottom: 8px; }
  p { font-size: 12px; color: var(--muted); }
  @media (max-width: 1023px) { .feature-copy { padding: 20px 16px 25px; } h3 { font-size: 17px; } }
  @media (max-width: 767px) {
    .features { padding-top: 64px; padding-bottom: 64px; }
    .features-grid { grid-template-columns: 1fr; margin-top: 30px; }
    .feature + .feature { border-left: 0; border-top: 1px solid var(--line); }
    .feature-art { max-width: 360px; margin-inline: auto; padding: 8px 12px 0; }
    .feature-copy { padding: 10px 22px 26px; }
    h3 { font-size: 20px; }
    p { font-size: 13px; }
  }
</style>
