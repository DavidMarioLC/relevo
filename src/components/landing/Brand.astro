---
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<span class:list={['brand', { compact }]}>
  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
    <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.6" />
    <path d="M4 8.5c6.5-2 8.5 9 15.5 6.5M4 15.5c6.5 2 8.5-9 15.5-6.5" fill="none" stroke="currentColor" stroke-width="1.6" />
  </svg>
  <span>JURNITI<span class="brand-dot">°</span></span>
</span>
<style>
  .brand { display: inline-flex; align-items: center; gap: 7px; font-size: 16px; letter-spacing: -.045em; white-space: nowrap; }
  svg, .brand-dot { color: var(--orange); }
  .brand-dot { margin-left: 1px; }
  .compact { font-size: 12px; gap: 5px; }
  .compact svg { width: 17px; height: 17px; }
</style>
